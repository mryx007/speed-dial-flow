{
  "manifest_version": 2,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "version": "1.0",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "tabs",
    "storage",
    "<all_urls>"
  ],
  "chrome_url_overrides": {
    "newtab": "pages/newtab.html"
  },
  "chrome_settings_overrides": {
    "homepage": "pages/newtab.html"
  },
  "background": {
    "scripts": [
      "js/background.js"
    ],
    "persistent": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "speed-dial-flow@local",
      "strict_min_version": "150.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
